PORT=5000
NODE_ENV=development
# Solo para una instancia local privada. Nunca activar en staging/produccion.
LOCAL_DEVELOPMENT=true

DATABASE_URL=

PGHOST=localhost
PGPORT=5432
PGDATABASE=psicopanel
PGUSER=postgres
PGPASSWORD=postgres

DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
APP_BASE_URL=http://localhost:5173

# D2 disabled unless explicitly configured; never reuse JWT_SECRET.
D2_ENABLED=false
RESTRICTED_JWT_SECRET=
# Existing private mount owned by the API user; not a static/public directory.
PROFESSIONAL_MEDIA_ROOT=
