{
  "name": "psicologia-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node scripts/test-unit.js",
    "db:schema": "node scripts/run-sql-file.js sql/schema.sql && npm run db:migrate:clinical-integrity && npm run db:migrate:auth-sessions",
    "db:seed": "node scripts/run-sql-file.js sql/seed.sql",
    "db:init": "npm run db:init:dev",
    "db:init:dev": "npm run db:schema && npm run db:seed",
    "db:init:production": "node scripts/initialize-production.js",
    "db:normalize-appointments": "node scripts/normalize-appointment-times.js",
    "db:normalize-future-clinical-notes": "node scripts/normalize-future-clinical-notes.js",
    "db:migrate:clinical-integrity": "node scripts/run-sql-file.js sql/migrations/001_clinical_data_integrity.sql",
    "db:migrate:auth-sessions": "node scripts/run-sql-file.js sql/migrations/002_auth_session_version.sql",
    "test:integration": "node --test --test-concurrency=1 test/auth.security.integration.test.js test/clinical-integrity.integration.test.js test/backoffice-access.integration.test.js test/identity.integration.test.js test/contact-change.integration.test.js test/contact-change-review.integration.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:diagnose:episodes": "node scripts/diagnose-episodes.js",
    "test:episodes": "node --test --test-concurrency=1 test/clinical-episodes.integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
